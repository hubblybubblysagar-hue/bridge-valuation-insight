{
  "version": 1,
  "sdk_version": "0.21.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "exitbridge-mcp",
      "version": "0.1.0",
      "title": "ExitBridge MCP"
    },
    "tools": [
      {
        "name": "estimate_valuation",
        "title": "Estimate business valuation",
        "description": "Estimate a small business valuation range (low/base/high) from annual financials, industry, and qualitative risk answers. Returns the SDE, multiples used, confidence, value drivers, concerns, upside levers, and likely buyer types. Guidance only — not a formal appraisal.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "industry": {
              "type": "string",
              "enum": [
                "hvac",
                "plumbing",
                "electrical",
                "roofing",
                "landscaping",
                "pest",
                "healthcare",
                "ecommerce",
                "saas",
                "professional",
                "other"
              ],
              "description": "Industry code. Use list_industry_multiples to see options."
            },
            "financials": {
              "type": "object",
              "properties": {
                "revenue": {
                  "type": "number",
                  "description": "Trailing 12 months revenue in USD."
                },
                "netIncome": {
                  "type": "number",
                  "description": "Net income in USD."
                },
                "ownerCompensation": {
                  "type": "number",
                  "description": "Owner salary/compensation add-back."
                },
                "oneTimeExpenses": {
                  "type": "number",
                  "description": "Non-recurring expenses add-back."
                },
                "personalAddbacks": {
                  "type": "number",
                  "description": "Personal expenses run through the business."
                },
                "otherAddbacks": {
                  "type": "number",
                  "description": "Other justifiable add-backs."
                }
              },
              "required": [
                "revenue",
                "netIncome",
                "ownerCompensation",
                "oneTimeExpenses",
                "personalAddbacks",
                "otherAddbacks"
              ],
              "description": "Annual financials in USD."
            },
            "risk": {
              "type": "object",
              "properties": {
                "revenueType": {
                  "type": "string",
                  "enum": [
                    "recurring",
                    "repeat",
                    "one-time",
                    "mixed"
                  ]
                },
                "customerConcentration": {
                  "type": "string",
                  "description": "Top customer as % of revenue, e.g. '18'."
                },
                "ownerRelationships": {
                  "type": "string",
                  "enum": [
                    "yes",
                    "no"
                  ]
                },
                "transitionSupport": {
                  "type": "string",
                  "enum": [
                    "yes",
                    "no"
                  ]
                },
                "keyEmployees": {
                  "type": "string",
                  "enum": [
                    "yes",
                    "no",
                    "unsure"
                  ]
                },
                "bookQuality": {
                  "type": "string",
                  "enum": [
                    "very-clean",
                    "clean",
                    "somewhat-messy",
                    "not-sure"
                  ]
                }
              },
              "required": [
                "revenueType",
                "customerConcentration",
                "ownerRelationships",
                "transitionSupport",
                "keyEmployees",
                "bookQuality"
              ],
              "description": "Qualitative risk answers."
            }
          },
          "required": [
            "industry",
            "financials",
            "risk"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_industry_multiples",
        "title": "List industry multiples",
        "description": "List the industry codes ExitBridge supports along with their baseline SDE multiples. Use this to pick a valid `industry` value for estimate_valuation.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "generate_teaser",
        "title": "Generate anonymous buyer teaser",
        "description": "Draft an anonymous, buyer-ready teaser for a small business. No identifying details (name, address, brand) are included — output uses generalized region and industry only. Returns markdown suitable for private buyer outreach.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "industryLabel": {
              "type": "string",
              "description": "Human-readable industry (e.g. 'HVAC')."
            },
            "region": {
              "type": "string",
              "description": "Generalized region (e.g. 'Southeast US')."
            },
            "yearsInBusiness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "revenue": {
              "type": "number",
              "description": "Annual revenue in USD."
            },
            "sde": {
              "type": "number",
              "description": "Seller's Discretionary Earnings in USD."
            },
            "valuationLow": {
              "type": "number"
            },
            "valuationHigh": {
              "type": "number"
            },
            "highlights": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "3–6 short bullet highlights (recurring revenue, team, contracts, etc.)."
            },
            "reasonForSale": {
              "type": "string",
              "description": "Anonymous rationale (e.g. 'Owner retirement')."
            }
          },
          "required": [
            "industryLabel",
            "region",
            "yearsInBusiness",
            "revenue",
            "sde",
            "valuationLow",
            "valuationHigh",
            "highlights",
            "reasonForSale"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
